* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bash text eol=lf
# Upstream terminal recordings are byte streams, including intentional CR/LF.
*.recording binary
*.vte binary
# Patches against vendored crates are applied byte-exact (scripts/vendor-check.ps1).
vendor/patches/*.patch -text
